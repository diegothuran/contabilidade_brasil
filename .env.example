# Valores falsos, só para localhost. Não use em nenhum outro ambiente.
POSTGRES_PASSWORD=dev-only-postgres-password
CONTABIL_APP_PASSWORD=dev-only-db-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin
DEV_USER_PASSWORD=dev-only-password
# Porta do Keycloak no host. O padrão do plano é 8080; use outra se ela já estiver ocupada.
KEYCLOAK_PORT=8080
MINIO_ROOT_USER=dev-only-minio
MINIO_ROOT_PASSWORD=dev-only-minio-secret
