# Variáveis da API do piloto. Valores de exemplo: troque todos antes do heroku config:set.
# A imagem do piloto fixa ENVIRONMENT=pilot; com ela, a API recusa a subida se um destes
# valores for de desenvolvimento (dev-only, localhost), se as claims de identidade faltarem
# ou se SEED_DEMO estiver ligado.
#
# DATABASE_URL vem do add-on Heroku Postgres e não entra aqui.
OUTBOX_IN_PROCESS=1
OIDC_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/POOL_ID
OIDC_AUDIENCE=CLIENT_ID
OIDC_JWKS_URL=https://cognito-idp.us-east-2.amazonaws.com/POOL_ID/.well-known/jwks.json
OIDC_USERNAME_CLAIM=cognito:username
OIDC_TENANT_CLAIM=custom:tenant_id
OBJECT_STORAGE_ENDPOINT=https://s3.us-east-2.amazonaws.com
OBJECT_STORAGE_BUCKET=NOME-DO-BUCKET
OBJECT_STORAGE_ACCESS_KEY=CHAVE
OBJECT_STORAGE_SECRET_KEY=SEGREDO
OBJECT_STORAGE_REGION=us-east-2
CORS_ORIGINS=https://NOME-WEB.herokuapp.com
# Convite por Cognito e aviso por e-mail (opcionais; sem eles o convite responde 503).
COGNITO_ADMIN_ACCESS_KEY=
COGNITO_ADMIN_SECRET_KEY=
MAIL_FROM=
SES_ACCESS_KEY=
SES_SECRET_KEY=
PORTAL_BASE_URL=https://NOME-WEB.herokuapp.com
