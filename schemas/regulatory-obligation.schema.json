{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade-brasil.local/schemas/regulatory-obligation.schema.json",
  "title": "Regulatory obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "obligation_id", "tenant_id", "legal_entity_id", "obligation_type", "jurisdiction", "competence", "status", "rule_version"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "obligation_id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "tenant_id": { "type": "string", "maxLength": 160 },
    "legal_entity_id": { "type": "string", "maxLength": 160 },
    "establishment_id": { "type": ["string", "null"], "maxLength": 160 },
    "obligation_type": { "type": "string", "enum": ["ecd", "ecf", "nfe", "nfse", "cte", "mdfe", "esocial", "efd_reinf", "dctfweb", "other"] },
    "jurisdiction": { "type": "object", "additionalProperties": false, "required": ["country"], "properties": { "country": { "type": "string", "pattern": "^[A-Z]{2}$" }, "state": { "type": ["string", "null"], "maxLength": 2 }, "municipality_code": { "type": ["string", "null"], "maxLength": 20 }, "authority": { "type": ["string", "null"], "maxLength": 200 } } },
    "competence": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "due_date": { "type": ["string", "null"], "format": "date" },
    "status": { "type": "string", "enum": ["planned", "collecting", "ready", "validating", "transmitting", "accepted", "rejected", "pending_correction", "rectified", "cancelled"] },
    "rule_version": { "type": "string", "maxLength": 160 },
    "layout_version": { "type": ["string", "null"], "maxLength": 160 },
    "dependencies": { "type": "array", "items": { "type": "string", "maxLength": 160 }, "maxItems": 50 },
    "files": { "type": "array", "items": { "type": "string", "maxLength": 160 }, "maxItems": 100 },
    "transmissions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["transmission_id", "status"], "properties": { "transmission_id": { "type": "string" }, "status": { "type": "string", "enum": ["created", "sent", "accepted", "rejected", "cancelled"] }, "protocol": { "type": ["string", "null"] }, "receipt_ref": { "type": ["string", "null"] }, "sent_at": { "type": ["string", "null"], "format": "date-time" } } }, "maxItems": 50 },
    "coverage": { "type": "string", "enum": ["native", "partner", "file_only", "pending_homologation", "not_supported"] }
  }
}
