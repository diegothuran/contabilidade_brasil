{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade-brasil.local/schemas/journal-entry.schema.json",
  "title": "Journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "journal_id", "tenant_id", "legal_entity_id", "period_id", "status", "currency", "lines", "source", "created_by"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "journal_id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "legal_entity_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "period_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "published", "reversed", "rejected"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "entry_date": { "type": "string", "format": "date" },
    "description": { "type": "string", "maxLength": 2000 },
    "lines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_id", "account_id", "side", "amount", "description"],
        "properties": {
          "line_id": { "type": "string", "maxLength": 160 },
          "account_id": { "type": "string", "maxLength": 160 },
          "side": { "type": "string", "enum": ["debit", "credit"] },
          "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$" },
          "description": { "type": "string", "maxLength": 1000 },
          "cost_center_id": { "type": ["string", "null"], "maxLength": 160 },
          "dimension_values": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 160 }, "maxProperties": 20 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": { "type": "string", "enum": ["manual", "import", "payable", "receivable", "bank", "inventory", "asset", "fiscal_document", "adjustment", "reversal"] },
        "source_id": { "type": "string", "maxLength": 200 },
        "source_hash": { "type": ["string", "null"], "maxLength": 128 },
        "reverses_journal_id": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "created_by": { "type": "string", "maxLength": 160 },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "published_by": { "type": ["string", "null"], "maxLength": 160 },
    "audit_event_id": { "type": ["string", "null"], "maxLength": 160 }
  }
}
