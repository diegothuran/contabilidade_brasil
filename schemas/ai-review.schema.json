{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade-brasil.local/schemas/ai-review.schema.json",
  "title": "AI month review",
  "description": "Revisão do mês por IA de uma empresa numa competência (ADR 036). Os pontos são sugestão para conferência humana e não têm efeito contábil.",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "period_id", "legal_entity_id", "operation_id", "status", "model", "prompt_version", "packet_version", "stop_reason", "requested_by", "requested_at", "completed_at", "stale", "findings"],
  "properties": {
    "review_id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "period_id": { "type": "string", "maxLength": 160 },
    "legal_entity_id": { "type": "string", "maxLength": 160 },
    "operation_id": { "type": "string", "maxLength": 160 },
    "status": { "type": "string", "enum": ["requested", "completed", "incomplete", "failed"] },
    "model": { "type": "string", "maxLength": 80 },
    "prompt_version": { "type": "string", "maxLength": 40 },
    "packet_version": { "type": "string", "maxLength": 40 },
    "stop_reason": { "type": ["string", "null"], "maxLength": 40 },
    "requested_by": { "type": "string", "maxLength": 160 },
    "requested_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "stale": { "type": "boolean", "description": "Verdadeiro quando o pacote do mês mudou desde a revisão. Só a revisão concluída mais recente é conferida." },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "position", "relevance", "category", "title", "explanation", "evidence", "source", "decision"],
        "properties": {
          "finding_id": { "type": "string", "maxLength": 160 },
          "position": { "type": "integer", "minimum": 1 },
          "relevance": { "type": "string", "enum": ["alta", "média", "baixa"] },
          "category": { "type": "string", "enum": ["variacao", "classificacao", "saldo", "coerencia", "pendencia", "outro"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "explanation": { "type": "string", "maxLength": 600 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(conta|conferencia|indicador|pendencia):[^\\s]+$" }
          },
          "source": { "const": "model" },
          "decision": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["decision", "note", "decided_by", "decided_at"],
            "properties": {
              "decision": { "type": "string", "enum": ["procede", "nao_procede"] },
              "note": { "type": ["string", "null"], "maxLength": 500 },
              "decided_by": { "type": "string", "maxLength": 160 },
              "decided_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
