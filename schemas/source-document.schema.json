{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade-brasil.local/schemas/source-document.schema.json",
  "title": "Source document and evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "tenant_id", "document_type", "original", "provenance", "retention"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "document_id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "tenant_id": { "type": "string", "maxLength": 160 },
    "legal_entity_id": { "type": ["string", "null"], "maxLength": 160 },
    "document_type": { "type": "string", "enum": ["invoice", "bank_statement", "receipt", "contract", "tax_file", "government_response", "journal_support", "other"] },
    "competence": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "media_type", "sha256", "object_ref"],
      "properties": {
        "file_name": { "type": "string", "maxLength": 300 },
        "media_type": { "type": "string", "maxLength": 160 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "object_ref": { "type": "string", "maxLength": 1000 },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "received_at"],
      "properties": {
        "source_type": { "type": "string", "enum": ["upload", "email", "api", "government", "import", "generated"] },
        "source_ref": { "type": ["string", "null"], "maxLength": 300 },
        "received_at": { "type": "string", "format": "date-time" },
        "received_by": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "legal_hold", "retain_until"],
      "properties": {
        "policy_id": { "type": "string", "maxLength": 160 },
        "legal_hold": { "type": "boolean" },
        "retain_until": { "type": ["string", "null"], "format": "date" }
      }
    },
    "classification": { "type": ["string", "null"], "maxLength": 160 },
    "derived_versions": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["version_id", "derived_from_sha256"], "properties": { "version_id": { "type": "string" }, "derived_from_sha256": { "type": "string" }, "transform": { "type": "string", "maxLength": 500 } } } }
  }
}
