{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade-brasil.local/schemas/close-run.schema.json",
  "title": "Close run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "close_run_id", "tenant_id", "legal_entity_id", "period_id", "status", "run_number", "checklist_version", "checklist"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1.0" },
    "close_run_id": { "type": "string", "minLength": 8, "maxLength": 160 },
    "tenant_id": { "type": "string", "maxLength": 160 },
    "legal_entity_id": { "type": "string", "maxLength": 160 },
    "period_id": { "type": "string", "maxLength": 80 },
    "status": { "type": "string", "enum": ["open", "closing", "closed", "reopened", "cancelled"] },
    "run_number": { "type": "integer", "minimum": 1 },
    "checklist_version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "category", "status", "title"],
        "properties": {
          "item_id": { "type": "string", "maxLength": 160 },
          "category": { "type": "string", "enum": ["master_data", "subledger", "bank", "tax", "documents", "reports", "obligation", "approval"] },
          "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "completed", "not_applicable"] },
          "title": { "type": "string", "maxLength": 500 },
          "owner_id": { "type": ["string", "null"], "maxLength": 160 },
          "evidence_ref": { "type": ["string", "null"], "maxLength": 200 },
          "blocking": { "type": "boolean" },
          "detail": { "type": "string", "maxLength": 2000 },
          "count": { "type": ["integer", "null"], "minimum": 0 },
          "not_applicable_reason": { "type": ["string", "null"], "maxLength": 2000 },
          "decided_by": { "type": ["string", "null"], "maxLength": 160 },
          "href": { "type": "string", "maxLength": 200 },
          "reference": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "snapshot_ref": { "type": ["string", "null"], "maxLength": 200 },
    "snapshot_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "evidence_package_ref": { "type": ["string", "null"], "maxLength": 200 },
    "reopened_reason": { "type": ["string", "null"], "maxLength": 2000 },
    "approved_by": { "type": ["string", "null"], "maxLength": 160 },
    "closed_by": { "type": ["string", "null"], "maxLength": 160 },
    "closed_at": { "type": ["string", "null"], "maxLength": 40 },
    "audit_event_id": { "type": ["string", "null"], "maxLength": 160 }
  }
}
